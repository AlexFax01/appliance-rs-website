Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.appliancesc\.com$ [NC]
  RewriteRule ^ https://appliancesc.com%{REQUEST_URI} [R=301,L]
  RewriteRule ^(?:wp-admin|wp-content|wp-includes)(?:/|$) - [R=404,L]
  RewriteRule ^wp-(?:activate|blog-header|comments-post|config|cron|links-opml|load|login|mail|settings|signup|trackback)\.php$ - [R=404,L]
  RewriteRule ^(?:index|xmlrpc)\.php$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js|woff2|avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
