NEXT_PUBLIC_SITE_URL=https://appliancesc.com
NEXT_PUBLIC_SITE_STAGE=production
# Client-owned GTM container, for example GTM-XXXXXXX. GA4 is configured only in GTM.
NEXT_PUBLIC_GTM_ID=
# Browser key restricted to this site's referrers + Maps JavaScript API.
# Requires client-owned billing and JavaScript Map ID. Empty = classic embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
